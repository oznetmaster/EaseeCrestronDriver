<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net472</TargetFramework><GenerateDocumentationFile>true</GenerateDocumentationFile><GenerateDriverPackage>false</GenerateDriverPackage><CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies><AssemblyName>EaseeCrestronDriver</AssemblyName></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EaseeCrestronDriver.Core/EaseeCrestronDriver.Core.csproj" />
    <PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="29.0.10" />
    <PackageReference Include="Crestron.SimplSharp.SDK.Library" Version="2.22.15" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Crestron.DeviceDrivers.ManifestUtil" Version="29.0.10" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <EmbeddedResource Include="EaseeCrestronDriver.json" />
    <InternalsVisibleTo Include="EaseeCrestronDriver.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <IsPackable>true</IsPackable><IncludeBuildOutput>false</IncludeBuildOutput><SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageType>CrestronHomeDriver</PackageType><PackageId>CrestronHomeDriver.Easee.Charger</PackageId>
    <Description>Crestron Home Entity V2 Easee charger driver distribution containing the final .pkg payload.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile><PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/oznetmaster/EaseeCrestronDriver</RepositoryUrl><RepositoryType>git</RepositoryType><PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/oznetmaster/EaseeCrestronDriver</PackageProjectUrl><PackageTags>crestron;crestron-home;driver;pkg;easee;charger;energy;smarthome</PackageTags>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotesFile)' != '' And Exists('$(PackageReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(PackageReleaseNotesFile)'))</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(PackageDriverPkgPath)" Pack="true" PackagePath="/" Visible="false" Condition="'$(PackageDriverPkgPath)' != ''" />
    <None Include="$(PackageDriverManifestPath)" Pack="true" PackagePath="/" Visible="false" Condition="'$(PackageDriverManifestPath)' != ''" />
  </ItemGroup>
  <Target Name="ValidateNuGetWrapperInputs" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(PackageDriverPkgPath)' == '' Or !Exists('$(PackageDriverPkgPath)')" Text="Provide the verified Release .pkg through PackageDriverPkgPath." />
    <Error Condition="'$(PackageDriverManifestPath)' == '' Or !Exists('$(PackageDriverManifestPath)')" Text="Provide crestron-driver-package.json through PackageDriverManifestPath." />
  </Target>
  <Import Project="../scripts/DriverPackage.targets" />
</Project>
